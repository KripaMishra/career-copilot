# One libSQL database for all durable backend state.
# Development/test: absolute local file URL, no TURSO_AUTH_TOKEN.
MASTRA_DATA_DIR=/absolute/path/to/career-copilot-data
MASTRA_DATABASE_URL=file:/absolute/path/to/career-copilot-data/career-copilot.db

# Production Turso: uncomment both. Do not put credentials in MASTRA_DATABASE_URL.
# MASTRA_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Single owner and Telegram private-chat authorization
CAREER_COPILOT_OWNER_RESOURCE_ID=career-owner-v0
CAREER_COPILOT_OWNER_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
CAREER_COPILOT_PRIVATE_CHAT_IDS=

# Main model and observer/reflector model for Observational Memory
CAREER_COPILOT_MODEL=opencode-go/deepseek-v4-flash
CAREER_COPILOT_MEMORY_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# PII redaction (@kripamishra/mastra-pii).
# Disabled by default; enable to activate resume ingestion and the agent processor.
# Booleans must be exactly true/false (invalid values fail startup).
PII_ENABLED=false
# Optional remote Presidio analyzer (NER). When set, the URL is supplied to the
# package's presidio adapter at init (detects names/addresses too, e.g. http://localhost:3000
# for a local presidio-analyzer container). When absent, the local deterministic
# engine is used — zero network egress. Warmup/fail-closed applies either way.
PII_PRESIDIO_URL=
# Optional JSON array of custom patterns: [{"name":"account-code","regex":"ACCT-[0-9]{6}","entity":"bank-account"}]
# entity must be in the package allowlist: aadhaar, pan, upi, ifsc, phone, email, credit-card, ...
PII_PATTERNS=
# Placeholder style: type ([PAN_1]) | uniform ([REDACTED])
PII_ANONYMIZE_FORMAT=type
# Redaction input cap in characters (0 = unlimited); aligned with the 200,000 extraction bound
PII_MAX_INPUT_CHARS=200000
# Readiness gate: when false, ingestion surfaces stay disabled even if the engine warms
PII_READINESS=true
