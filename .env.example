# Model providers
OPENCODE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Persistent runtime state. Use an absolute file URL locally or a libsql/HTTPS URL in deployment.
MASTRA_DATA_DIR=/absolute/path/to/career-copilot-data
MASTRA_DATABASE_URL=file:/absolute/path/to/career-copilot-data/mastra.db
TURSO_AUTH_TOKEN=

# Telegram. Keep actual values in the runtime environment, never in source control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ALLOWED_USER_IDS=
CAREER_COPILOT_PRIVATE_CHAT_IDS=

# Google Sheets target. OAuth access/refresh tokens are intentionally not configured here.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TRACKER_TAB=Applications
GOOGLE_SHEETS_APPLICATION_LOG_TAB=Application Log
GOOGLE_SHEETS_TOPICS_TAB=Topics
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/spreadsheets

# Private local paths.
CAREER_COPILOT_PROFILE_DIR=/absolute/path/to/profile
CAREER_COPILOT_REPORTS_DIR=/absolute/path/to/career-copilot-reports
CAREER_COPILOT_TOPICS_DIR=/absolute/path/to/career-copilot-topics
CAREER_COPILOT_INPUT_DIR=/absolute/path/to/csv-input
CAREER_COPILOT_PROCESSED_DIR=/absolute/path/to/csv-processed
