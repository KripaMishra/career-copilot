# Mastra workflow storage (absolute local file URL; existing data is never deleted)
MASTRA_DATA_DIR=/absolute/path/to/career-copilot-data
MASTRA_DATABASE_URL=file:/absolute/path/to/career-copilot-data/mastra.db

# Single owner and Telegram private-chat authorization
CAREER_COPILOT_OWNER_RESOURCE_ID=career-owner-v0
CAREER_COPILOT_OWNER_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
CAREER_COPILOT_PRIVATE_CHAT_IDS=

# Model used by the one structured analysis call
CAREER_COPILOT_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local trust-boundary roots
CAREER_COPILOT_PROFILE_DIR=/absolute/path/to/profile
CAREER_COPILOT_REPORTS_DIR=/absolute/path/to/career-copilot-reports

# Sheets target and OAuth (required for real completion)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TRACKER_TAB=Applications
GOOGLE_SHEETS_APPLICATION_LOG_TAB="Application Log"
GOOGLE_SHEETS_TOPICS_TAB=Topics
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/spreadsheets
